# ==============================================================================
# ScamShield India - Environment Variables Template
# ==============================================================================

# Application Environment (development | production | testing)
ENVIRONMENT=development
DEBUG=True

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-me-to-a-secure-random-secret-key-at-least-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration
# Local SQLite fallback for zero-dependency dev:
DATABASE_URL=sqlite+aiosqlite:///./scamshield.db
# PostgreSQL for Docker / Production:
# DATABASE_URL=postgresql+asyncpg://scamshield:scamshield_pass@db:5432/scamshield_db

# Redis Cache and Rate Limiting
REDIS_URL=redis://redis:6379/0
# Set to false to allow local dev without running Redis (falls back to memory rate limiting)
REDIS_ENABLED=false

# Google OAuth 2.0 / OpenID Connect (Optional for guests, required for Google sign-in)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Admin Role Configuration (Comma-separated emails)
ADMIN_EMAILS=admin@scamshield.org,team@scamshield.org

# Model and Engine Versions
MODEL_VERSION=indicbert-v2-scam-v1
RULES_VERSION=v1.0.0

# Security and Input Constraints
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_INPUT_CHARS=5000
RATE_LIMIT_PER_MINUTE=60

# Frontend Environment Variables (Prefix with NEXT_PUBLIC_ for Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="ScamShield India"

